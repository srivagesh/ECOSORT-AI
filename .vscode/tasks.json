{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start E-Waste System (All-in-One)",
      "type": "shell",
      "command": "${workspaceFolder}\\run_project.bat",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "1. Start Backend (Flask)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\venv313\\Scripts\\python.exe app.py",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend_upload\\frontend"
      },
      "problemMatcher": []
    }
  ]
}
